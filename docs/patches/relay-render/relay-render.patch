+  if(pin.size()!=4 || !std::all_of(pin.begin(),pin.end(),[](QChar c){return c>=QChar('0')&&c<=QChar('9');}))return;
+  if(session){backend->enterPin(pin);std::printf("RELAY_RENDER {\"type\":\"pinRequired\",\"required\":false}\n");std::fflush(stdout);}
+  return;
+ }
+ if(command.value("type").toString()=="stop"){
+  // User stop/app exit sleeps the console; settings reconnection opts out.
+  // No native confirmation dialog is involved in either path.
+  if(session)backend->stopSession(command.value("standby").toBool(true));else QCoreApplication::quit();
+  return;
+ }
+ if(command.value("type").toString()=="devices"){
+  QJsonObject devices{{"type","devices"},{"devices",relayCaptureDevices()}};
+  std::printf("RELAY_RENDER %s\n",QJsonDocument(devices).toJson(QJsonDocument::Compact).constData());std::fflush(stdout);return;
+ }
+ if(command.value("type").toString()!="settings" || !command.value("settings").isObject()) return;
+ auto next=command.value("settings").toObject();
+ QElapsedTimer apply_timer;apply_timer.start();
+ if(next==relay_settings && relay_revision!=0){
+  QMutexLocker lock(&relay_control_mutex);
+  relay_revision=static_cast<quint64>(command.value("revision").toDouble());
+  relay_settings_ms=apply_timer.nsecsElapsed()/1000000.0;
+  QJsonObject ack{{"type","settingsAccepted"},{"revision",static_cast<double>(relay_revision)}};
+  std::printf("RELAY_RENDER %s\n",QJsonDocument(ack).toJson(QJsonDocument::Compact).constData());std::fflush(stdout);return;
+ }
+ const auto previous=relay_settings;const bool first_settings=relay_revision==0;
+ auto changed=[&](std::initializer_list<const char*> keys){if(first_settings)return true;for(auto key:keys)if(next.value(key)!=previous.value(key))return true;return false;};
+ drainRenderThread();
+ if(next.value("pictureSource").toString()=="capture" && !next.value("captureDeviceId").toString().isEmpty()){
+  bool capture_changed=!relay_capture;
+  for(auto key:{"captureDeviceId","captureWidth","captureHeight","captureFps","captureFormat","captureColorRange","captureHdrMode"})if(next.value(key)!=relay_settings.value(key))capture_changed=true;
+  if(capture_changed){
+  if(relay_capture){delete relay_capture;relay_capture=nullptr;}
+  relay_capturing=true;direct_stream=true;emit directStreamChanged();stream_session_active.storeRelease(1);
+  relay_capture=new RelayCapture(this,next);relay_capture->start();
+  }
+ }else if(relay_capture){delete relay_capture;relay_capture=nullptr;relay_capturing=false;}
+ QMutexLocker relay_lock(&relay_control_mutex);
+ relay_upscaler_state.storeRelaxed(0);
+ relay_settings=next;relay_revision=static_cast<quint64>(command.value("revision").toDouble());
+ auto number=[&](const char*k,double d){return next.value(k).toDouble(d);};
+ auto text=[&](const char*k,const char*d){return next.value(k).toString(QString::fromUtf8(d));};
+ auto flag=[&](const char*k){return next.value(k).toBool(false);};
+ if(first_settings){settings->SetPlaceboPreset(PlaceboPreset::Custom);settings->SetDirectFrameMapping(true);settings->SetFrameGenCleanup(1);settings->SetPlaceboFrameMixer(PlaceboFrameMixer::None);}
+ if(changed({"neuralRendering","neuralRenderingIntensity","neuralRenderingPreset"})){
+ settings->SetNeuralRender(flag("neuralRendering"));settings->SetNeuralRenderUpscale(false);
+ NeuralRenderTuning t;const double strength=number("neuralRenderingIntensity",1.0);
+ t.intensity=qBound(0.0,strength,1.0);t.local_structure=qBound(0.0,strength,2.0);
+ t.style=text("neuralRenderingPreset","default")=="cinematic"?2:text("neuralRenderingPreset","default")=="natural"?1:0;
+ settings->SetNeuralRenderPasses(1);settings->SetNeuralRenderTuning(0,t);
+ }
+ if(changed({"frameGeneration","frameGenerationBackend","frameGenerationMultiplier"})){
+ settings->SetFrameGenBackend(!flag("frameGeneration")?0:text("frameGenerationBackend","warp")=="dlssg"?1:text("frameGenerationBackend","warp")=="nvidia"?4:3);
+ settings->SetFrameGenMultiplier(qBound(2,static_cast<int>(number("frameGenerationMultiplier",2)),4));
+ }
+ if(changed({"framePacing"}))settings->SetVSyncEnabled(text("framePacing","auto")=="smooth-vsync");
+ if(changed({"toneMapMode"})){
+ const auto tone=text("toneMapMode","auto");
+ settings->SetDisplayTargetTrc(tone=="bt2390-sdr"?PL_COLOR_TRC_BT_1886:tone=="hdr10-passthrough"?PL_COLOR_TRC_PQ:0);
+ settings->SetDisplayTargetPrim(tone=="bt2390-sdr"?PL_COLOR_PRIM_BT_709:tone=="hdr10-passthrough"?PL_COLOR_PRIM_BT_2020:0);
+ settings->SetDisplayTargetPeak(tone=="bt2390-sdr"?203:0);
+ settings->SetRelayRenderValue("tone_mapping",tone=="bt2390-sdr"?"bt2390":"spline");
+ }
+ pl_renderer_reset_errors(placebo_renderer,nullptr);
+ if(changed({"ambientFill"}))settings->SetAmbientBorder(flag("ambientFill"));
+ if(changed({"upscalerSharpness"}))settings->SetRcasStrength(qRound(number("upscalerSharpness",0)*100));
+ const auto algorithm=text("upscaler","off");
+ if(changed({"upscaler","upscalerQuality"})){
+ settings->SetPlaceboUpscaler(algorithm=="fsr1"?PlaceboUpscaler::FSR:algorithm=="integer"?PlaceboUpscaler::Nearest:PlaceboUpscaler::Bilinear);
+ settings->SetRtxVsrQuality(algorithm=="rtx-vsr" ? qMax(1,text("upscalerQuality","0").toInt()==0?4:text("upscalerQuality","0").toInt()) : 0);
+ }
+ settings->SetRelayRenderValue("deband",flag("debanding")?"yes":"no");
+ settings->SetRelayRenderValue("deband_iterations",text("debandingStrength","medium")=="high"?3:1);
+ settings->SetRelayRenderValue("deband_threshold",text("debandingStrength","medium")=="low"?2:4);
+ settings->SetRelayRenderValue("sigmoid",flag("antiAliasing")?"yes":"no");
+ settings->SetRelayRenderValue("color_adjustment","yes");
+ settings->SetRelayRenderValue("saturation",QString::number(number("saturation",1),'f',3));
+ settings->SetRelayRenderValue("contrast",QString::number(number("contrast",1),'f',3));
+ settings->SetRelayRenderValue("gamma",QString::number(number("gamma",1),'f',3));
+ settings->SetRelayRenderValue("temperature",QString::number(number("colorTemperature",0),'f',3));
+ settings->SetRelayRenderValue("brightness",QString::number(qBound(-1.0,number("brightness",0),1.0),'f',3));
+ relay_exposure.set(number("exposure",0));
+ const auto shader=relayFilterShader(next);
+ if(shader!=relay_filter_source || (!shader.isEmpty() && !relay_filter_hook)){
+  if(relay_filter_hook)pl_mpv_user_shader_destroy(&relay_filter_hook);
