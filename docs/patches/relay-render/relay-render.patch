+		{"devicePeriodMs", 1000.0 * s.period_frames / s.rate},
+		{"queuedMs", 1000.0 * s.queued_frames / s.rate},
+		{"peakQueuedMs", 1000.0 * s.peak_frames / s.rate},
+		{"capacityMs", 1000.0 * s.capacity_frames / s.rate},
+		{"droppedFrames", double(s.dropped_frames)}, {"underruns", double(s.underruns)},
+		{"playedFrames", double(s.played_frames)}, {"callbacks", double(s.callbacks)}};
