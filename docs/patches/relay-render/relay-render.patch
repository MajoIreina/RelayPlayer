+void QmlMainWindow::presentRelayCapture(AVFrame *frame,double fps){
+ fps=fps>0?fps:60;relay_capture_pts+=1.0/fps;
+ stream_configured_frame_interval_ms=1000.0/fps;
+ relay_delivering=true;
+ presentFrame(ChiakiFfmpegFrame{.frame=frame,.pts=relay_capture_pts,.duration=1.0/fps,.recovered=false,.packet_size=65536},0);
+ relay_delivering=false;
+}
+
+void QmlMainWindow::startRelayRenderTest(){
+    // Deterministic synthetic pixels, no device, console or account is accessed.
+    relay_capturing=true;stream_session_active.storeRelease(1);
+    auto timer=new QTimer(this);timer->setInterval(16);
+    connect(timer,&QTimer::timeout,this,[this]{
+        AVFrame *frame=av_frame_alloc();if(!frame)return;
+        frame->format=AV_PIX_FMT_RGB24;frame->width=640;frame->height=360;
+        frame->color_range=AVCOL_RANGE_JPEG;frame->colorspace=AVCOL_SPC_RGB;
+        frame->color_primaries=AVCOL_PRI_BT709;frame->color_trc=AVCOL_TRC_BT709;
+        if(av_frame_get_buffer(frame,32)<0){av_frame_free(&frame);return;}
+        for(int y=0;y<frame->height;y++)for(int x=0;x<frame->width;x++){
+            auto p=frame->data[0]+y*frame->linesize[0]+x*3;p[0]=32+x*200/640;p[1]=16+y*100/360;p[2]=220-x*160/640;
+        }
+        presentRelayCapture(frame,60);
+    });timer->start();
+}
