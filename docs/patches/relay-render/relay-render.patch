+bool QmlMainWindow::verifyRelayIntegration()
+{
+    setProperty("relay-self-test",true);
+    show();
+    const auto initial=QJsonDocument::fromJson(qgetenv("RELAY_RENDER_SETTINGS"));
+    if(initial.isObject())applyRelaySettings(QJsonObject{{"type","settings"},{"revision",1},{"settings",initial.object()}});
+    setStatsOverlayActive(true);
+    backend->setDiscoveryEnabled(true);
+    QKeyEvent menu(QEvent::KeyPress,Qt::Key_O,Qt::ControlModifier);
+    const bool shortcut_ignored=!handleShortcut(&menu);
+    const bool surface=quick_item && quick_item->objectName()=="relay-video-surface";
+    const bool clean=surface && !stats_overlay_widget && !stats_overlay_visible && !backend->discoveryEnabled() && shortcut_ignored;
+    QJsonObject result{{"type","integrationTest"},{"videoOnlyRoot",surface},{"noStatsOverlay",!stats_overlay_widget && !stats_overlay_visible},
+      {"discoveryDisabled",!backend->discoveryEnabled()},{"nativeShortcutsDisabled",shortcut_ignored},
+      {"configuredMultiplier",settings->GetFrameGenMultiplier()},{"configuredFrameGenBackend",settings->GetFrameGenBackend()}};
+    // Test resource lifetime without a console or a video stream.
+    auto edit=relay_settings;edit["clarity"]=0.4;edit["upscaler"]="artcnn";
+    auto apply=[&]{applyRelaySettings(QJsonObject{{"type","settings"},{"revision",static_cast<double>(relay_revision+1)},{"settings",edit}});};
+    apply();
+    const auto filter=relay_filter_hook,art=relay_artcnn_hook;
+    const auto nr_revision=settings->GetNeuralRenderTuningRevision();
+    const auto filter_count=relay_filter_rebuilds,art_count=relay_artcnn_rebuilds;
+    edit["brightness"]=0.25;apply();apply();
+    const bool reused=filter && art && relay_filter_hook==filter && relay_artcnn_hook==art && relay_filter_rebuilds==filter_count && relay_artcnn_rebuilds==art_count && settings->GetNeuralRenderTuningRevision()==nr_revision;
+    edit["exposure"]=0.5;apply();
+    const bool exposure_reused=relay_exposure.get() && relay_filter_rebuilds==filter_count && relay_artcnn_rebuilds==art_count;
+    edit["clarity"]=0.6;apply();
+    const bool selective=exposure_reused && relay_filter_rebuilds==filter_count+1 && relay_artcnn_rebuilds==art_count && settings->GetNeuralRenderTuningRevision()==nr_revision;
+    for(auto key:{"exposure","clarity","textureRecovery","vibrance","shadowBoost","filmGrain"})edit[key]=0;
+    edit["upscaler"]="off";apply();
+    const bool bypass=!relay_exposure.get() && !relay_filter_hook && !relay_artcnn_hook;
+    result["settingsResourceReuse"]=reused;result["selectiveFilterRebuild"]=selective;result["neutralFilterBypass"]=bypass;
+    std::printf("RELAY_RENDER %s\n",QJsonDocument(result).toJson(QJsonDocument::Compact).constData());std::fflush(stdout);
+    return clean && reused && selective && bypass;
+}
